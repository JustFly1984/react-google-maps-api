{
  "name": "react-google-maps-api-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently 'bun dev' 'bun dev:api'",
    "dev": "vite",
    "dev:api": "wrangler dev --port 8788",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typegen": "wrangler types",
    "tc": "tsc --project ./tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 execute react_google_maps_api_db --local --file=./schema.sql",
    "db:migrate": "wrangler d1 execute react_google_maps_api_db --remote --file=./schema.sql",
    "lint": "bunx goatlint app/**/*.{ts,tsx} functions/**/*.ts shared/**/*.ts --fix",
    "login": "wrangler login",
    "setup:d1": "wrangler d1 create react_google_maps_api_db",
    "setup:kv": "wrangler kv:namespace create RATE_LIMIT && wrangler kv:namespace create PASSWORD_RESET",
    "setup:migrate": "wrangler d1 execute react_google_maps_api_db --file=./schema.sql",
    "setup:secrets": "echo 'Setup secrets manually:' && echo 'wrangler secret put JWT_SECRET' && echo 'wrangler secret put STRIPE_SECRET_KEY' && echo 'wrangler secret put STRIPE_WEBHOOK_SECRET' && echo 'wrangler secret put RESEND_API_KEY' && echo 'wrangler secret put APP_URL'"
  },
  "dependencies": {
    "@react-router/node": "7.12.0",
    "@stripe/stripe-js": "8.6.1",
    "clsx": "2.1.1",
    "concurrently": "9.2.1",
    "hono": "4.12.12",
    "hono-react-router-adapter": "0.6.5",
    "i18next": "25.7.4",
    "i18next-browser-languagedetector": "8.2.0",
    "i18next-fs-backend": "2.6.1",
    "i18next-http-backend": "3.0.2",
    "isbot": "5.1.32",
    "lucide-react": "0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "16.5.2",
    "react-router": "7.12.0",
    "react-router-dom": "7.12.0",
    "remix-i18next": "7.4.2",
    "shiki": "3.21.0",
    "stripe": "20.1.2",
    "valibot": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.20.1",
    "@cloudflare/workers-types": "4.20260111.0",
    "@hono/vite-dev-server": "0.24.0",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "goatfmt": "0.44.0",
    "goatlint": "1.59.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "wrangler": "4.58.0"
  }
}
